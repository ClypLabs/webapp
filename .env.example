# Better Auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Optional social sign-in providers. Leave unset until each app is registered.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Added automatically by the Vercel/Neon integration.
DATABASE_URL=

# Xbox Live linking (the client ID is public; redirect URI must be registered in Entra)
XBOX_CLIENT_ID=
# Required when the Entra redirect is registered as a Web platform.
XBOX_CLIENT_SECRET=
XBOX_REDIRECT_URI=https://www.clypdat.xyz/api/xbox/callback
